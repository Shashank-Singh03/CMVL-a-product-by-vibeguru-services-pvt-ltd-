diff --git a/scripts/backup.sh b/scripts/backup.sh
--- /dev/null
+++ b/scripts/backup.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+# Copy the notes file to the backup bucket.
+set -euo pipefail
+
+backup_notes() {
+  local stamp
+  stamp="$(date +%F)"
+  aws s3 cp notes.json "s3://notes-backups/notes-${stamp}.json"
+}
+
+backup_notes

